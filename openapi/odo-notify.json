          "event_id": {
            "type": "integer",
            "format": "int64"
          },
          "is_read": {
            "type": "boolean"
          },
          "source_entity_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "source_entity_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_service": {
            "type": [
              "string",
              "null"
            ]
