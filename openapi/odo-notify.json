            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "recipient_email_group": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "recipient_user": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "EmailGroupDetailResponse": {
        "type": "object",
        "required": [
          "group",
          "members"
        ],
        "properties": {
          "group": {
            "$ref": "#/components/schemas/EmailGroupRow"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmailGroupMemberRow"
            }
          }
        }
      },
      "EmailGroupIdRequest": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "EmailGroupMemberIdRequest": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "EmailGroupMemberRow": {
        "type": "object",
        "required": [
          "id",
          "email_group",
          "email",
          "is_active",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string"
          },
          "email_group": {
            "type": "integer",
            "format": "int32"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "EmailGroupPage": {
        "type": "object",
        "description": "One page of email groups.",
        "required": [
          "rows",
          "total"
        ],
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmailGroupRow"
            },
            "description": "The rows on this page."
          },
          "total": {
            "type": "integer",
            "format": "int64",
            "description": "Total rows matching the filter, ignoring limit/offset."
          }
        }
      },
      "EmailGroupRow": {
        "type": "object",
        "required": [
          "id",
          "code",
          "label",
          "is_active",
          "created_at",
          "updated_at",
          "member_count",
          "active_member_count"
        ],
        "properties": {
          "active_member_count": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "is_active": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "member_count": {
            "type": "integer",
            "format": "int64"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EnqueueRequest": {
        "type": "object",
        "required": [
          "recipients",
          "template_code"
        ],
        "properties": {
          "dedup_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "recipients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Recipient"
            }
          },
          "scheduled_for": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_entity_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "source_entity_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_service": {
            "type": [
              "string",
              "null"
            ]
          },
          "template_code": {
            "type": "string"
          },
          "template_variables": {}
        }
      },
      "EnqueueResponse": {
        "type": "object",
        "required": [
          "event_id",
          "deliveries",
          "is_duplicate"
        ],
        "properties": {
          "deliveries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeliveryInfo"
            }
          },
          "event_id": {
            "type": "integer",
            "format": "int64"
          },
          "is_duplicate": {
            "type": "boolean"
          }
        }
      },
      "ListEmailGroupsRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Page"
          },
          {
            "$ref": "#/components/schemas/Sort"
          },
          {
            "type": "object",
            "properties": {
              "include_inactive": {
                "type": "boolean"
              },
              "search": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        ]
      },
      "ListRequest": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ListResponse": {
        "type": "object",
        "required": [
          "notifications",
