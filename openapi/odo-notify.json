              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "org_unit": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Defaults to the root org unit."
          },
          "sample_data": {},
          "subject_template": {
            "type": "string"
          }
        }
      },
      "DeliveryIdRequest": {
        "type": "object",
        "required": [
          "delivery_id"
