            ]
          },
          "label": {
            "type": "string"
          }
        }
      },
      "CreateTemplateRequest": {
        "type": "object",
        "required": [
          "code",
          "name",
          "subject_template",
          "body_template"
        ],
        "properties": {
          "body_template": {
            "type": "string"
          },
          "body_template_html": {
            "type": [
