# Rendered to /etc/nginx/conf.d/default.conf at container start.
# Define JSON log format
log_format json_access escape=json '{'
    '"time_iso8601":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"remote_user":"$remote_user",'
    '"request_method":"$request_method",'
    '"request_uri":"$request_uri",'
    '"server_protocol":"$server_protocol",'
    '"status":$status,'
    '"body_bytes_sent":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"http_referer":"$http_referer",'
    '"http_user_agent":"$http_user_agent",'
    '"http_x_forwarded_for":"$http_x_forwarded_for",'
    '"upstream_response_time":"$upstream_response_time",'
    '"upstream_addr":"$upstream_addr",'
    '"host":"$host"'
'}';

# Conditional logging - skip kube-probe requests
map $http_user_agent $loggable {
    ~*kube-probe 0;
    default 1;
}

server {
    listen 8080;
    server_name localhost;

    access_log /var/log/nginx/access.log json_access if=$loggable;
    error_log /var/log/nginx/error.log warn;

    # Disable port in redirects when behind a proxy
    port_in_redirect off;

    # Trust proxy headers for proper URL generation
    # This ensures nginx uses the original protocol and host from the proxy
    absolute_redirect off;

    root /usr/share/nginx/html;
    index index.html;

    # @PREFIX@ is the base path without its trailing slash: empty when the
    # app is served at the host root, "/odo/admin" otherwise. It is
    # filled in at container start by docker-entrypoint.d/40-base-path.sh.

    # Never cache the SPA entry point so deploys take effect immediately
    location = @PREFIX@/index.html {
        alias /usr/share/nginx/html/index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location @PREFIX@/assets/ {
        alias /usr/share/nginx/html/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location @PREFIX@/ {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ @PREFIX@/index.html;
    }
@BARE_PREFIX_REDIRECT@
    error_page 404 @PREFIX@/index.html;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/rss+xml application/atom+xml image/svg+xml application/vnd.ms-fontobject application/x-font-ttf font/opentype image/x-icon;
}
